{
  "name": "engenheiro-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "validate:quizzes": "tsx scripts/validate-quizzes.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "npm run validate:quizzes && vite --host 127.0.0.1",
    "build": "npm run validate:quizzes && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
